# App
PORT=3000
NODE_ENV=development

# Database — replace USER and PASSWORD with your local PostgreSQL credentials
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nestlayer"

# Docker Compose (must match DATABASE_URL user, password, and database name)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestlayer

# JWT — for local development any long random strings are fine (use two different values)
JWT_SECRET=change_me_access_secret_local
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_local
JWT_REFRESH_EXPIRES_IN=7d
